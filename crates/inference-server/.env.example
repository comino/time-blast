# Export these into the Rust process; the service does not auto-read .env files.
TIME_BLAST_BIND=127.0.0.1:8787
TIME_BLAST_PROVIDER_URL=https://openrouter.ai/api/v1/chat/completions
TIME_BLAST_MODEL=google/gemini-2.5-flash-lite
TIME_BLAST_OPENROUTER=true
# Optional OpenRouter reasoning override; supported efforts depend on the model.
# TIME_BLAST_REASONING_EFFORT=none
# 0 is the default. Use provider to omit unsupported sampling parameters.
# TIME_BLAST_TEMPERATURE=provider
# Set OPENROUTER_API_KEY or TIME_BLAST_API_KEY privately in the server environment.
TIME_BLAST_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://time-blast.46-224-133-201.sslip.io
TIME_BLAST_MAX_CONCURRENT=4
TIME_BLAST_TIMEOUT_SECONDS=25
TIME_BLAST_REQUESTS_PER_MINUTE=30
TIME_BLAST_REQUESTS_PER_DAY=1000
