time-blast.46-224-133-201.sslip.io {
	root * /srv/time-blast/current

	# Inference node (tb1 over WebSocket).
	handle_path /api/inference/* {
		reverse_proxy 127.0.0.1:8787 {
			flush_interval -1
		}
	}

	# Remote database node (tb1 over WebSocket; deploy/time-blast-database.service).
	# reverse_proxy upgrades WebSockets as is; flush_interval -1 writes every frame at once.
	# The node checks Origin itself (TIME_BLAST_ALLOWED_ORIGINS).
	handle_path /api/database/* {
		reverse_proxy 127.0.0.1:8788 {
			flush_interval -1
			stream_timeout 24h
			stream_close_delay 5s
		}
	}

	# The build ships compressed DuckDB engines. Decode in the HTTP stack so
	# fetchEngineWasm can use the response directly, avoiding a JS decompression.
	@engine path /assets/*.wasm.gz
	header @engine Content-Type application/wasm
	header @engine Content-Encoding gzip

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@mutable not path /assets/*
	header @mutable Cache-Control "no-cache"
	header X-Content-Type-Options nosniff
	# Cross-origin isolation (SharedArrayBuffer, 5 µs timers). credentialless keeps CORS
	# fetches to Hugging Face (WebLLM weights) and extensions.duckdb.org working. Same values
	# as vite.config.ts.
	header Cross-Origin-Opener-Policy same-origin
	header Cross-Origin-Embedder-Policy credentialless

	encode zstd gzip
	file_server {
		precompressed gzip
	}
}
