[Unit]
Description=Time Blast Rust inference prototype
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fred
Group=fred
EnvironmentFile=/etc/time-blast/inference.env
ExecStart=/srv/time-blast/backend/time-blast-inference
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LimitNOFILE=4096
MemoryMax=256M

[Install]
WantedBy=multi-user.target
